{
  "name": "@globalfishingwatch/gfw-cli",
  "version": "0.4.5",
  "description": "MCP server for Global Fishing Watch data — vessel search, events, fishing hours, and region lookups",
  "author": "Global Fishing Watch",
  "license": "Apache-2.0",
  "repository": {
    "url": "https://github.com/GlobalFishingWatch/gfw-mcp-js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "global-fishing-watch",
    "gfw",
    "fishing",
    "vessels",
    "ais"
  ],
  "main": "./dist/index.js",
  "bin": {
    "gfw": "./dist/bin.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && cp package.json dist/package.json",
    "start": "node dist/index.js",
    "dev": "tsx index.ts",
    "cli": "tsx cli/index.ts",
    "link": "npm run build && npm link",
    "prepublishOnly": "npm run build",
    "lint": "eslint 'tools/**/*.ts' 'lib/**/*.ts'",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@sentry/node": "^10.48.0",
    "axios": "^1.13.6",
    "commander": "^14.0.3",
    "express": "^5.1.0",
    "fuse.js": "^7.3.0",
    "playwright": "^1.59.1",
    "qs": "^6.15.1",
    "undici": "^7.25.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
